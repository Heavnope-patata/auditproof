{
  "name": "auditproof",
  "version": "0.2.0",
  "description": "Audit framework for autonomous trading agents: zero-knowledge proofs + three independent witnesses + on-chain record.",
  "private": true,
  "scripts": {
    "genkeys": "node scripts/genkeys.js",
    "build-circuit": "bash circuits/build.sh",
    "witness:custodian": "node witness-services/custodian/index.js",
    "witness:oracle": "node witness-services/oracle/index.js",
    "witness:sanctions": "node witness-services/sanctions/index.js",
    "witness:all": "node witness-services/custodian/index.js & node witness-services/oracle/index.js & node witness-services/sanctions/index.js",
    "compile-policy": "ts-node policy-compiler/compile.ts",
    "prove": "ts-node prover/generate-proof.ts",
    "verify": "node prover/verify-proof.js",
    "inspect-public": "node prover/inspect-public.js",
    "day2:demo": "bash scripts/run-day2-demo.sh",
    "ui": "node demo-ui/server.js",
    "chain:node": "hardhat node",
    "chain:demo": "hardhat run scripts/deploy_and_demo.js --network localhost",
    "compile-contracts": "hardhat compile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "ajv": "^8.17.1",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "chai": "^4.5.0",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
